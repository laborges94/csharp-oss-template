# 1. Global configuration and automatic normalization
* text=auto

# 2. Source code files (Force LF)
*.cs text eol=lf
*.cshtml text eol=lf
*.razor text eol=lf
*.css text eol=lf
*.js text eol=lf
*.ts text eol=lf
*.json text eol=lf

# 3. Solution and Project files (Force CRLF for Visual Studio compatibility)
*.sln text eol=crlf
*.csproj text eol=crlf
*.props text eol=crlf
*.targets text eol=crlf

# 4. Block Common Binary Files of .NET
*.dll binary
*.pdb binary
*.exe binary
*.appsettings.json text

# 5. Optimization of Code Review (Ignore automatically generated code in GitHub/GitLab)
*.designer.cs linguist-generated=true
*.g.cs linguist-generated=true
*.AssemblyAttributes.cs linguist-generated=true

# 6. Export Rules (git archive)
/.github export-ignore
/.images export-ignore
*.md export-ignore